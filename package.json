{
  "name": "idle-page",
  "version": "0.0.1",
  "private": true,
  "description": "A discreet VS Code novel reader with status bar reading, online book sources, and account authentication.",
  "type": "module",
  "scripts": {
    "probe:qidian": "node labs/qidian/cli.mjs public",
    "login:qidian": "node labs/qidian/cli.mjs session",
    "check:labs": "node --check labs/qidian/cli.mjs && node --check labs/qidian/browser.mjs && node --check labs/qidian/probe.mjs && node --check labs/qidian/manual-browser.mjs && node --check labs/qidian/diagnose.mjs && node --check labs/qidian/browser-companion/worker.js && node --check labs/qidian/browser-companion/content.js && node --check labs/qidian/browser-companion/status.js",
    "manual:qidian": "node labs/qidian/manual-browser.mjs",
    "test:labs": "node --test labs/qidian/browser-companion.test.mjs",
    "companion:qidian": "node labs/qidian/manual-browser.mjs --extensions",
    "check:types": "tsc --noEmit",
    "build": "npm run check:types && node scripts/build.mjs",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:extension": "npm run build && node scripts/test-extension.mjs",
    "vscode:prepublish": "npm run build",
    "dev:live": "npm run build && node scripts/live-extension.mjs",
    "check:browser": "node --check browser-extension/worker.js && node --check browser-extension/content.js && node --check browser-extension/status.js && node --check browser-extension/bookshelf.js && node --check browser-extension/catalog.js && node --check browser-extension/chapter.js && node --check browser-extension/login.js"
  },
  "engines": {
    "node": ">=22",
    "vscode": "^1.95.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "displayName": "IdlePage",
  "publisher": "myosotis0v0",
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "configuration": {
      "properties": {
        "idlepage.reading.location": {
          "type": "string",
          "enum": ["statusBar", "sidebar", "panel"],
          "enumDescriptions": ["状态栏", "侧栏阅读区", "底部面板"],
          "default": "statusBar",
          "scope": "application",
          "description": "正文显示位置，可通过书本菜单中的文本显示位置切换。"
        },
        "idlepage.bridge.port": {
          "default": 17655,
          "maximum": 65535,
          "minimum": 1024,
          "description": "本机浏览器连接端口，修改后需重启插件并重新加载配对的浏览器扩展。",
          "type": "integer",
          "scope": "machine"
        },
        "idlepage.browser.autoStart": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "发起阅读或接入任务时自动启动专用 Edge，并等待浏览器辅助扩展执行任务。"
        },
        "idlepage.browser.autoHide": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "读取任务中自动隐藏专用 Edge。需要登录时显示；手动显示进入排查状态，手动隐藏退出。"
        },
        "idlepage.cache.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "启用本机私有阅读缓存；修改后重启插件生效。"
        },
        "idlepage.cache.maxSizeMB": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 4096,
          "scope": "machine",
          "description": "本地阅读缓存容量（MiB），包含索引；超额时优先淘汰最久未使用的正文。"
        },
        "idlepage.reading.widthPercent": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 80,
          "description": "正文区目标占 VS Code 窗口总宽度的百分比，根据窗口宽度和缩放估算，并非精确布局宽度。"
        }
      },
      "title": "IdlePage"
    },
    "commands": [
      {
        "command": "idlepage.openKeybindings",
        "title": "余页: 配置快捷键"
      },
      {
        "command": "idlepage.selectReadingLocation",
        "title": "余页: 文本显示位置"
      },
      {
        "command": "idlepage.showBrowser",
        "title": "IdlePage: 显示辅助浏览器"
      },
      {
        "command": "idlepage.hideBrowser",
        "title": "IdlePage: 隐藏辅助浏览器"
      },
      {
        "command": "idlepage.showStatus",
        "title": "IdlePage: 查看接入状态"
      },
      {
        "command": "idlepage.prepareBrowser",
        "title": "IdlePage: 准备浏览器连接"
      },
      {
        "command": "idlepage.restartProbe",
        "title": "IdlePage: 重新验证接入"
      },
      {
        "command": "idlepage.extractBookshelf",
        "title": "IdlePage: 测试当前页书单提取"
      },
      {
        "command": "idlepage.showBookshelf",
        "title": "IdlePage: 查看当前页书单"
      },
      {
        "command": "idlepage.extractCatalog",
        "title": "IdlePage: 测试第一本书目录"
      },
      {
        "command": "idlepage.showCatalog",
        "title": "IdlePage: 查看本次目录"
      },
      {
        "command": "idlepage.extractChapter",
        "title": "IdlePage: 测试第一章正文获取"
      },
      {
        "command": "idlepage.showChapter",
        "title": "IdlePage: 查看本次正文结果"
      },
      {
        "command": "idlepage.nextChapter",
        "title": "IdlePage: 下一章"
      },
      {
        "command": "idlepage.cancelTask",
        "title": "IdlePage: 取消当前获取或登录等待"
      },
      {
        "command": "idlepage.openBookshelf",
        "title": "余页: 进入书架"
      },
      {
        "command": "idlepage.refreshBookshelf",
        "title": "余页: 刷新书架"
      },
      {
        "command": "idlepage.refreshAll",
        "title": "余页: 全部刷新"
      },
      {
        "command": "idlepage.openSettings",
        "title": "余页: 设置"
      },
      {
        "command": "idlepage.previousSegment",
        "title": "余页: 上一段"
      },
      {
        "command": "idlepage.nextSegment",
        "title": "余页: 下一段"
      },
      {
        "command": "idlepage.toggleReading",
        "title": "余页: 隐藏/恢复阅读"
      },
      {
        "command": "idlepage.returnReading",
        "title": "余页: 返回阅读"
      },
      {
        "command": "idlepage.retryReading",
        "title": "余页: 重试阅读或预取"
      },
      {
        "command": "idlepage.openReadingDemo",
        "title": "余页: 打开底部阅读演示"
      },
      {
        "command": "idlepage.openSidebarReadingDemo",
        "title": "余页: 在 Codex 上方打开阅读演示"
      }
    ],
    "keybindings": [
      {
        "command": "idlepage.previousSegment",
        "key": "alt+left",
        "when": "idlepage.reading && !idlepage.readingHidden && !inputFocus"
      },
      {
        "command": "idlepage.nextSegment",
        "key": "alt+right",
        "when": "idlepage.reading && !idlepage.readingHidden && !inputFocus"
      },
      {
        "command": "idlepage.nextChapter",
        "key": "alt+down",
        "when": "idlepage.reading && !idlepage.readingHidden && !inputFocus"
      },
      {
        "command": "idlepage.toggleReading",
        "key": "alt+h",
        "when": "idlepage.reading || idlepage.webviewReading"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "idlepage-reader",
          "title": "余页",
          "icon": "media/book.svg"
        },
        {
          "id": "idlepage-demo",
          "title": "余页演示",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "idlepage-reader": [
        {
          "id": "idlepage.reader",
          "name": "阅读",
          "type": "webview",
          "when": "idlepage.webviewReading && !idlepage.readingHidden"
        }
      ],
      "idlepage-demo": [
        {
          "id": "idlepage.readingDemo",
          "name": "阅读预览",
          "type": "webview"
        },
        {
          "id": "idlepage.sidebarReadingDemo",
          "name": "余页阅读演示",
          "type": "webview",
          "visibility": "hidden"
        }
      ]
    }
  }
}
