{
  "name": "idle-page",
  "version": "0.0.1",
  "private": true,
  "description": "A discreet VS Code novel reader with status bar reading, online book sources, and account authentication.",
  "type": "module",
  "scripts": {
    "probe:qidian": "node labs/qidian/cli.mjs public",
    "login:qidian": "node labs/qidian/cli.mjs session",
    "check:labs": "node --check labs/qidian/cli.mjs && node --check labs/qidian/browser.mjs && node --check labs/qidian/probe.mjs && node --check labs/qidian/manual-browser.mjs && node --check labs/qidian/diagnose.mjs && node --check labs/qidian/browser-companion/worker.js && node --check labs/qidian/browser-companion/content.js && node --check labs/qidian/browser-companion/status.js",
    "manual:qidian": "node labs/qidian/manual-browser.mjs",
    "test:labs": "node --test labs/qidian/browser-companion.test.mjs",
    "companion:qidian": "node labs/qidian/manual-browser.mjs --extensions",
    "check:types": "tsc --noEmit",
    "build": "npm run check:types && node scripts/build.mjs",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:extension": "npm run build && node scripts/test-extension.mjs",
    "vscode:prepublish": "npm run build",
    "dev:live": "npm run build && node scripts/live-extension.mjs",
    "check:browser": "node --check browser-extension/worker.js && node --check browser-extension/content.js && node --check browser-extension/status.js && node --check browser-extension/bookshelf.js && node --check browser-extension/catalog.js && node --check browser-extension/chapter.js"
  },
  "engines": {
    "node": ">=22",
    "vscode": "^1.95.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "displayName": "IdlePage",
  "publisher": "myosotis0v0",
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "configuration": {
      "properties": {
        "idlepage.bridge.port": {
          "default": 17655,
          "maximum": 65535,
          "minimum": 1024,
          "description": "本机浏览器连接端口，修改后需重启插件并重新加载配对的浏览器扩展。",
          "type": "integer",
          "scope": "machine"
        },
        "idlepage.browser.autoStart": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "发起阅读或接入任务时自动启动专用 Edge，并等待浏览器辅助扩展执行任务。"
        }
      },
      "title": "IdlePage"
    },
    "commands": [
      {
        "command": "idlepage.showBrowser",
        "title": "IdlePage: 显示辅助浏览器"
      },
      {
        "command": "idlepage.hideBrowser",
        "title": "IdlePage: 隐藏辅助浏览器"
      },
      {
        "command": "idlepage.showStatus",
        "title": "IdlePage: 查看接入状态"
      },
      {
        "command": "idlepage.prepareBrowser",
        "title": "IdlePage: 准备浏览器连接"
      },
      {
        "command": "idlepage.restartProbe",
        "title": "IdlePage: 重新验证接入"
      },
      {
        "command": "idlepage.extractBookshelf",
        "title": "IdlePage: 测试当前页书单提取"
      },
      {
        "command": "idlepage.showBookshelf",
        "title": "IdlePage: 查看当前页书单"
      },
      {
        "command": "idlepage.extractCatalog",
        "title": "IdlePage: 测试第一本书目录"
      },
      {
        "command": "idlepage.showCatalog",
        "title": "IdlePage: 查看本次目录"
      },
      {
        "command": "idlepage.extractChapter",
        "title": "IdlePage: 测试第一章正文获取"
      },
      {
        "command": "idlepage.showChapter",
        "title": "IdlePage: 查看本次正文结果"
      },
      {
        "command": "idlepage.nextChapter",
        "title": "IdlePage: 下一章"
      }
    ]
  }
}
