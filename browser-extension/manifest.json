{
  "manifest_version": 3,
  "name": "IdlePage Browser Companion",
  "version": "0.0.6",
  "description": "Connects an ordinary browser session to the local IdlePage VS Code extension.",
  "key": "",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.qidian.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.qidian.com/*"
      ],
      "js": [
        "bookshelf.js",
        "catalog.js",
        "chapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
